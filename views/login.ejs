<%- include('partials/header'); -%>

<h1>login page</h1>
<form action="/signup" method="POST">
    <label for="email">Email:</label>
    <input type="email" name="email" required>
    <div class="email error"></div>

    <label for="password">Password:</label>
    <input type="password" name="password" required>
    <div class="password error"></div>
    
    <!-- Removed the stray </div> here -->
    <button type="submit">login</button>
</form>

<script>
    const form = document.querySelector('form');
    const emailError = document.querySelector('.email.error');
    const passwordError = document.querySelector('.password.error');

    // Fixed typo: addEventListener instead of addEventListner
    form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // reset error messages
        emailError.textContent = '';
        passwordError.textContent = '';

        // get the values from the form inputs
        const email = form.email.value;
        const password = form.password.value;

        try {
            const res = await fetch('/login', {
                method: 'POST',
                body: JSON.stringify({ email, password }),
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            console.log(data);
 
            if (data.errors) {// works, but the page doesn't redirect to the home page after login
                emailError.textContent = data.errors.email;
                passwordError.textContent = data.errors.password;
            }
            if (data.user) {// works, but the page doesn't redirect to the home page after login
                //location.assign('/');
                 location.assign('/');
            }
        } catch (err) {
            console.log(err);
        }
    });
</script>

<%- include('partials/footer'); -%>